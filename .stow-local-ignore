# A local list replaces GNU Stow's built-in exclusions; preserve them here.
RCS
.+,v

CVS
\.\#.+
\.cvsignore

\.svn
_darcs
\.hg

\.git
\.gitignore
\.gitmodules

.+~
\#.*\#

^/README.*
^/LICENSE.*
^/COPYING

# Project Pi metadata stays local; allow only reviewed global Pi files at the root.
^/.+/\.pi$
^/\.pi/(?!agent$)[^/]+$
^/\.pi/agent/(?!(?:AGENTS\.md|settings\.json|extensions|themes)$)[^/]+$
^/\.pi/agent/extensions/(?!(?:auto-theme\.ts|papercuts\.ts|whimsical\.ts)$).+
^/\.pi/agent/themes/(?!(?:flexoki-dark\.json|flexoki-light\.json)$).+

# Machine-local root tool versions and repository-only tests.
^/\.tool-versions$
^/tests

# Private machine-local settings.
^/\.config/darkman/config\.yaml$

# Generated runtime state.
\.zcompdump.*
__pycache__
.+\.py[cod]
^/\.config/rofi/global/history\.txt$
